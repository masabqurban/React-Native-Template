{
  "name": "react-native-template",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade React Native + TypeScript starter: Expo SDK 58, Expo Router, TanStack Query, Zod, secure token storage, Jest + Testing Library, EAS.",
  "license": "MIT",
  "author": "Masab Qurban",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "doctor": "expo-doctor",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^7.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.105.3",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@shopify/flash-list))"
    ],
    "setupFiles": [
      "@shopify/flash-list/jestSetup"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/test/**",
      "!src/app/**"
    ]
  }
}
