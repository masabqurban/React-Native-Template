# Copy to .env.local for development. Never commit real values.
# EXPO_PUBLIC_* values are inlined into the app bundle at build time, so they
# are PUBLIC: never put secrets here. All values are validated in src/config/env.ts.

# Base URL of the REST API, e.g. the companion Node.js-Template:
#   http://localhost:4000/api/v1   (iOS simulator / web)
#   http://10.0.2.2:4000/api/v1    (Android emulator)
#   http://<your-LAN-IP>:4000/api/v1 (physical device)
# Leave empty to run against the built-in mock API.
EXPO_PUBLIC_API_URL=

# Force the mock API on or off. Defaults to on when EXPO_PUBLIC_API_URL is empty.
EXPO_PUBLIC_ENABLE_MOCKS=
